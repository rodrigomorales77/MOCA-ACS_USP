# JWT
JWT_SECRET=reemplazar-con-secreto-largo-aleatorio
ADMIN_PASSWORD=reemplazar-con-password-seguro

# GenieACS UI (usado por docker-compose.yml)
GENIEACS_UI_JWT_SECRET=reemplazar-con-secreto-largo-aleatorio

# GenieACS NBI (interno Docker)
GENIEACS_NBI_URL=http://moca-genieacs:7557

# Simulator (opcional)
SIMULATOR_DEVICE_COUNT=50
SIMULATOR_ACS_URL=http://moca-genieacs:7547

# ont-gateway (F5)
GATEWAY_PORT=3001
GATEWAY_DB_PATH=/app/data/gateway.db
# GENIEACS_NBI_URL ya definido arriba (gateway usa http://moca-genieacs:7557 dentro de moca-net)
# GATEWAY_SEED_API_KEY=generar-con-crypto-randomBytes-32-hex-y-guardar-hash-SHA256-en-api_keys
# GATEWAY_SEED_API_KEY_NAME=sistema-gestion
